
@{
    ViewData["Title"] = "Bootstrap Playground";
}

<style>
    body {
        background-color: #101318;
        color: #e5e7eb;
    }

    .demo-section {
        background: #191f29;
        border: 1px solid #2b3442;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .demo-item {
        background: #293548;
        border: 1px solid #3d4d64;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        min-width: 80px;
    }

    .hover-effect {
        transition: all .25s ease;
    }

    .hover-effect:hover {
        transform: translateY(-4px);
        filter: brightness(1.2);
    }

    .fade-in {
        animation: fadeIn .7s ease both;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .color-box {
        height: 80px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
</style>

<div class="container py-5 fade-in">

    <!-- HEADER -->
    <header class="mb-5">
        <span class="badge bg-primary mb-3">BOOTSTRAP PLAYGROUND</span>

        <h1 class="display-4 fw-bold">
            Bootstrap <span class="text-primary">Guide.</span>
        </h1>

        <p class="text-secondary">
            Laboratório visual para testar componentes, cores,
            flexbox, alinhamentos e animações.
        </p>
    </header>

    <!-- BUTTONS -->
    <section class="demo-section">
        <h3 class="mb-4">01. Buttons</h3>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary">Primary</button>
            <button class="btn btn-secondary">Secondary</button>
            <button class="btn btn-success">Success</button>
            <button class="btn btn-danger">Danger</button>
            <button class="btn btn-warning">Warning</button>
            <button class="btn btn-info">Info</button>
            <button class="btn btn-light">Light</button>
            <button class="btn btn-dark">Dark</button>
        </div>

        <hr class="border-secondary my-4">

        <h5>Outline Buttons</h5>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-outline-primary">Primary</button>
            <button class="btn btn-outline-success">Success</button>
            <button class="btn btn-outline-danger">Danger</button>
            <button class="btn btn-outline-warning">Warning</button>
            <button class="btn btn-outline-info">Info</button>
        </div>

        <hr class="border-secondary my-4">

        <h5>Button Sizes</h5>

        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary btn-lg">Large</button>
            <button class="btn btn-primary">Normal</button>
            <button class="btn btn-primary btn-sm">Small</button>
        </div>
    </section>

    <!-- FLEX -->
    <section class="demo-section">
        <h3 class="mb-2">02. Flexbox</h3>
        <p class="text-secondary">d-flex + gap + justify-content</p>

        <h6 class="mt-4">Flex Row</h6>

        <div class="d-flex flex-row gap-3 flex-wrap">
            <div class="demo-item">Item 1</div>
            <div class="demo-item">Item 2</div>
            <div class="demo-item">Item 3</div>
        </div>

        <h6 class="mt-4">Justify Content Between</h6>

        <div class="d-flex justify-content-between gap-2 flex-wrap">
            <div class="demo-item">Left</div>
            <div class="demo-item">Center</div>
            <div class="demo-item">Right</div>
        </div>

        <h6 class="mt-4">Flex Column</h6>

        <div class="d-flex flex-column gap-2">
            <div class="demo-item">Item 1</div>
            <div class="demo-item">Item 2</div>
            <div class="demo-item">Item 3</div>
        </div>

        <h6 class="mt-4">Align Items Center</h6>

        <div class="d-flex align-items-center justify-content-center gap-3"
             style="height: 150px; background: #111722; border-radius: 10px;">
            <div class="demo-item">A</div>
            <div class="demo-item">B</div>
            <div class="demo-item">C</div>
        </div>
    </section>

    <!-- COLORS -->
    <section class="demo-section">
        <h3 class="mb-4">03. Background Colors</h3>

        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="color-box bg-primary">Primary</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-success">Success</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-danger">Danger</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-warning text-dark">Warning</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-info text-dark">Info</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-dark border border-secondary">Dark</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-secondary">Secondary</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="color-box bg-light text-dark">Light</div>
            </div>
        </div>
    </section>

    <!-- ANIMATIONS -->
    <section class="demo-section">
        <h3 class="mb-4">04. Hover & Animations</h3>

        <div class="d-flex flex-wrap gap-3">
            <button class="btn btn-primary hover-effect">
                Hover Me
            </button>

            <button class="btn btn-success hover-effect">
                Move Up
            </button>

            <div class="demo-item hover-effect">
                Hover Card
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="p-4 bg-dark rounded fade-in">
            <h5>Fade In Animation</h5>
            <p class="text-secondary mb-0">
                Este elemento aparece suavemente quando a página carrega.
            </p>
        </div>
    </section>

    <!-- SPACING -->
    <section class="demo-section">
        <h3 class="mb-4">05. Spacing</h3>

        <div class="bg-primary p-2 mb-2 rounded">p-2</div>
        <div class="bg-success p-3 mb-2 rounded">p-3</div>
        <div class="bg-danger p-4 mb-2 rounded">p-4</div>
        <div class="bg-warning p-5 rounded text-dark">p-5</div>
    </section>

    <footer class="text-center text-secondary py-4">
        <small>Bootstrap Playground · ASP.NET Core MVC</small>
    </footer>

</div>
